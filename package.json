{
  "name": "BiliBili-Overlay-Player",
  "version": "1.0.0",
  "description": "B站半透明鼠标穿透播放器",
  "main": "main.js",
  "author": "Ameamezz",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.ameamezz.biliplayer",
    "productName": "AemeathTool",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "vitest": "^1.6.1"
  }
}
